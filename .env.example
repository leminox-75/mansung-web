# PostgreSQL 데이터베이스 접속 URL
# 형식: postgresql+asyncpg://사용자명:비밀번호@호스트:포트/데이터베이스명
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/ptenp_db

# CORS 허용 출처 (쉼표 구분)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# 카카오맵 JavaScript API 키 (https://developers.kakao.com 에서 발급)
KAKAO_MAP_API_KEY=your_kakao_map_api_key_here
